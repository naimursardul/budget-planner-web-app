# ---- Database (MongoDB Atlas) ----
MONGODB_URI=

# ---- Auth.js ----
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Access / trial ----
# Days of full access a new account gets before purchase is required
TRIAL_DAYS=14

# ---- Pricing (shown on /pricing — configure your real prices here) ----
NEXT_PUBLIC_ONE_YEAR_PRICE=$29
NEXT_PUBLIC_TWO_YEAR_PRICE=$49

# ---- Email (password reset) ----
# Until both are set, the forgot-password page says so plainly instead of
# pretending a message was sent. Get a key at resend.com.
RESEND_API_KEY=
RESEND_FROM="Smart Budget Planner <noreply@yourdomain.com>"

# ---- Lemon Squeezy (all server-only except checkout mode) ----
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_ONE_YEAR_VARIANT_ID=
LEMON_SQUEEZY_TWO_YEAR_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Optional: "overlay" (popup) or "redirect" checkout behaviour
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_MODE=overlay
